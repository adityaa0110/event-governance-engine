# Optional — without these keys the demo fallback analyzer is used
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Local demo leaves authentication disabled. Set AUTH_DISABLED=false for OIDC.
AUTH_DISABLED=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OIDC_SCOPES=openid profile email
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://localhost:8080
# Leave unset for the local SQLite database. Docker Compose sets PostgreSQL.
# DATABASE_URL=postgresql+psycopg://governance:governance@postgres:5432/governance
LOG_LEVEL=INFO
# Applied only when AUTH_DISABLED=false. Docker also rate-limits at Nginx.
RATE_LIMIT=120
# 0 keeps audit rows. A positive number deletes older rows on startup.
AUDIT_RETENTION_DAYS=0
ALERT_WEBHOOK_URL=
# Optional secret files. When set, they replace the matching environment variable.
# DATABASE_URL_FILE=
# LLM_API_KEY_FILE=
# Mount real certificates at deploy/certs or set TLS_CERT_DIR. An empty directory
# gets a local self-signed certificate when the web container starts.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
BACKUP_S3_BUCKET=
